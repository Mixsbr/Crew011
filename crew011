  document.body.style.background=BG[bgk][dark()?1:0];
  let img;try{img=await load(`screens/${file(r)}.svg`)}catch(e){console.error(e);ld.style.transform="scaleX(0)";return}
  if(id!==seq)return;
  img.alt=TTL[bgk]+(r.t==="det"?" — detalhe "+r.n:"");
  pg.querySelectorAll(".layer").forEach((l,i,a)=>{if(i<a.length-1)l.remove()});
  const old=pg.querySelector(".layer"),layer=document.createElement("div");
  layer.className="layer";layer.appendChild(img);layer.insertAdjacentHTML("beforeend",spots(r));if(r.t==="sec")layer.appendChild(placeGame(r.s));
  if(old){const rc=old.getBoundingClientRect();pg.style.minHeight=rc.height+"px";
    pg.appendChild(layer);old.style.cssText=`position:fixed;left:${rc.left}px;top:${rc.top}px;width:${rc.width}px;z-index:1;pointer-events:none`}
  else pg.appendChild(layer);
  cur=r;document.title=`${TTL[bgk]} · O Legado Periférico`;
  metrics();
  const tk=r.t==="home"?"Home":r.t==="gloss"?"Glossario":({grafite:"Grafite",mc:"MC",dj:"DJ",break:"Break"}[r.s]);
  urlFor(`assets/menu_${r.t==="gloss"||r.t==="home"?"Home":tk}_${theme}.png`).then(u=>mimg.src=u);menu.hidden=false;
  urlFor(`assets/top_${tk}_${theme}.png`).then(u=>topimg.src=u);
  $("#top").style.background=(r.t==="home"||r.t==="gloss")?"#380065":PAL[r.s][dark()?1:0].ft;
  closeAll();
  const y=keep!==undefined?keep:(backFlag&&scrollMap[r.k]!==undefined?scrollMap[r.k]:0);scrollTo(0,y);backFlag=false;
  const [ms,ease]=ANIM[kind],fr=kind==="slide"?[{transform:"translateX(100%)"},{transform:"none"}]:[{opacity:0},{opacity:1}];
  const an=layer.animate(fr,{duration:D(ms),easing:ease,fill:"backwards"});
  const done=()=>{if(id===seq){old&&old.remove();pg.style.minHeight=""}};
  an.onfinish=done;an.oncancel=done;
  ld.style.transform="scaleX(1)";setTimeout(()=>ld.style.transform="scaleX(0)",300)}
function closeAll(){sc.classList.remove("on");ov.hidden=true;cd.hidden=true;ov.innerHTML="";cd.innerHTML=""}
