  if(b){const k=b.dataset.a;
    if(k==="theme"){theme=dark()?"Light":"Dark";anim="gentle";sfx(dark()?"dark":"light");try{localStorage.setItem("theme",theme)}catch(x){}render(scrollY)}
    else if(k==="card"){sfx("cardOpen");openCard(+b.dataset.d)}else if(k==="close"){sfx("cardClose");closeAll()}return}
  if(e.target===sc){sfx(ov.hidden?"cardClose":"menuClose");closeAll()}});
