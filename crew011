 }catch(e){console.error(e)}}
document.addEventListener("click",e=>{
  const a=e.target.closest("a.hs,a.th,a.dn"),b=e.target.closest("button.hs,button.th,button.dn,#menu");
  if(a){const lb=a.getAttribute("aria-label")||"";
    sfx(a.closest("#ov")?"menuItem":lb==="Próximo"?"next":/Voltar/.test(lb)?"back":/detalhes/i.test(lb)?"detail":/^Início$/.test(lb)?"home":"tap");
    scrollMap[cur.k]=scrollY;backFlag=/Voltar/.test(lb);anim=lb==="Próximo"?"slide":(cur.t==="home"?"gentle":"dissolve");if(sc.classList.contains("on"))closeAll();return}
