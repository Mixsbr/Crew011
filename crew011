  const b64=PACK[src];
  if(/\.png$/.test(src))return "data:image/png;base64,"+b64;
  const bin=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));
  let txt=await new Response(new Blob([bin]).stream().pipeThrough(new DecompressionStream("gzip"))).text();
  if(txt.includes("@@TEX@@"))txt=txt.split("@@TEX@@").join("data:image/png;base64,"+PACK.tex);
  TX.set(src,txt);return URL.createObjectURL(new Blob([txt],{type:"image/svg+xml"}))}
async function urlFor(src){
  if(UC.has(src))return UC.get(src);
  const u=(window.PACK&&PACK[src])?await unpack(src):src;UC.set(src,u);
  if(/\.svg$/.test(src)&&UC.size>14){for(const k of UC.keys()){if(/\.svg$/.test(k)&&k!==src){const v=UC.get(k);if(v.startsWith("blob:"))URL.revokeObjectURL(v);UC.delete(k);TX.delete(k);break}}}
  return u}
function imgFrom(u){return new Promise((ok,no)=>{const i=new Image();i.decoding="async";i.onload=()=>ok(i);i.onerror=no;i.src=u})}
function dataFromText(t){const b=new TextEncoder().encode(t);let s="";for(let i=0;i<b.length;i+=32768)s+=String.fromCharCode.apply(null,b.subarray(i,i+32768));return "data:image/svg+xml;base64,"+btoa(s)}
async function load(src){
  const u=await urlFor(src);
  try{return await imgFrom(u)}catch(e){
    if(u.startsWith("blob:")&&TX.has(src)){const d=dataFromText(TX.get(src));UC.set(src,d);return await imgFrom(d)}
    throw e}}
const mimg=$("#mimg"),topimg=$("#topimg");
async function render(keep){
  const r=parse(location.hash),id=++seq,ld=$("#ld"),kind=ANIM[anim]?anim:"dissolve";anim="dissolve";
